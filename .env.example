MOODLE_BASE_URL=https://sea.acatlan.unam.mx
MOODLE_USER=tu_usuario_o_correo
MOODLE_PASS=tu_contraseña

# Curso por defecto si no se especifica uno en la petición o en el JSON
# Tus cursos disponibles: 22841, 22842
MOODLE_COURSE_ID=22841,22842

# Clave secreta para proteger tu Webhook
API_SECRET=mi_clave_secreta

# Clave de API de Google AI Studio (Obténla gratis en https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Token principal de Hugging Face
HF_TOKEN=hf_tu_token_aqui

# Token secundario de respaldo para rotación automática si se agota la cuota del primero
HF_TOKEN_2=hf_tu_segundo_token_aqui

# Opcional: Lista de múltiples tokens separados por coma (HF_TOKENS=token1,token2,token3)
# HF_TOKENS=hf_token1,hf_token2,hf_token3

# Token de ngrok (obténlo gratis en https://dashboard.ngrok.com/get-started/your-authtoken)
NGROK_AUTHTOKEN=tu_ngrok_authtoken
